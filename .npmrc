# Faz o pnpm hoistar pacotes CSS para a raiz do node_modules
# Necessário para o Next.js resolver tailwindcss/postcss/autoprefixer
# durante o build (next-font-loader e css plugins precisam disso)
public-hoist-pattern[]=*tailwind*
public-hoist-pattern[]=*postcss*
public-hoist-pattern[]=*autoprefixer*
public-hoist-pattern[]=*prisma*
public-hoist-pattern[]=@prisma/*
