# ────────────────────────────────────────────────────────────────
# Variáveis de ambiente de PRODUÇÃO para a VPS
# Copie este arquivo para .env.prod e preencha os valores
# NUNCA commite o .env.prod no git!
# ────────────────────────────────────────────────────────────────

# ─── Banco de Dados ──────────────────────────────────────────────
POSTGRES_USER=mundomagico
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE_AQUI
POSTGRES_DB=mundomagico_prod

# ─── Redis ───────────────────────────────────────────────────────
REDIS_PASSWORD=TROQUE_POR_SENHA_REDIS_AQUI

# ─── Segurança / Auth ────────────────────────────────────────────
JWT_SECRET=GERE_COM_openssl_rand_-hex_64
ENCRYPTION_KEY=GERE_COM_openssl_rand_-hex_32
NEXTAUTH_SECRET=GERE_COM_openssl_rand_-hex_32

# ─── URLs ────────────────────────────────────────────────────────
# URL da sua API na VPS (ex: https://api.mundomagico.com.br)
API_URL=https://api.SEU_DOMINIO.com.br

# URL do admin na Vercel
NEXTAUTH_URL=https://admin.SEU_DOMINIO.vercel.app

# ─── SMTP (E-mail) ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@email.com
SMTP_PASS=sua_senha_de_app
SMTP_FROM=sistema@mundomagico.com.br

# ─── WhatsApp (opcional) ─────────────────────────────────────────
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
