# =============================================================
# MUNDO MÁGICO - Variáveis de Ambiente (copie para .env.local)
# =============================================================

# URL pública do site na VPS — obrigatório para o NextAuth funcionar
# Exemplo: https://mundomagicocajamar.com.br
NEXTAUTH_URL=https://SEU_DOMINIO_AQUI

# Chave secreta do NextAuth — gere com: openssl rand -base64 32
NEXTAUTH_SECRET=GERE_UMA_CHAVE_SECRETA_AQUI

# URL da API backend (se houver serviço separado)
NEXT_PUBLIC_API_URL=http://localhost:3002
API_URL=http://localhost:3002
